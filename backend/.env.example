# ===== 复制本文件为 .env 后填写（.env 已被 .gitignore 排除，不会进仓库）=====

# ---- 应用密钥：生产环境请换成 64 字节随机串，切不可沿用示例值 ----
# 生成方式（PowerShell）：-join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | ForEach-Object {[char]$_})
SECRET_KEY=
JWT_SECRET=
# 登录令牌有效期（小时）
JWT_EXPIRE_HOURS=12

# ---- MySQL 连接 ----
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=openmv_ai

# ---- 跨域白名单：逗号分隔，前端地址 ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 首次启动自动创建的管理员账号 ----
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=

# ---- 设备上报令牌：设备端请求头 X-Device-Token 必须与之一致 ----
DEVICE_TOKEN=
