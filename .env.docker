# 部署用环境变量（docker-compose 读取）
# 复制为 .env 后改成你服务器 MySQL 的实际账号、密码、库名
DB_USER=fruit_user
DB_PASSWORD=换成服务器fruit_user的密码
DB_NAME=openmv_ai

# 生产密钥：不写这两行，config.py 会退回 dev-secret-key，
# 等于全站 JWT 可被任何人伪造（2026-11-28 生产环境就是这样退化的）。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=换成随机串
JWT_SECRET=换成另一个随机串

# 允许跨域的前端来源（逗号分隔，不要写 *）
CORS_ORIGINS=http://你的服务器IP:4173

# 设备上报令牌：必须与 openmv_script/main.py、nn_classify.py 里的 DEVICE_TOKEN 一致，
# 不写会用示例值 openmv-device-2026（等于谁都能伪造设备上报）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_TOKEN=换成随机串

# 安全审计（可选）：同一 IP 同类型事件的合并窗口秒数 / 事件保留天数
SECURITY_MERGE_WINDOW=60
SECURITY_EVENT_KEEP_DAYS=90
