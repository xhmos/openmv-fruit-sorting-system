backend/.env
backend/.env.local
*.env
!.env.example

# ===== 运行时产物 =====
backend/uploads/
backend/logs/
*.log

# ===== Python 缓存 =====
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# ===== 前端构建产物 =====
frontend/dist/
frontend/.vite/

# ===== 下载的安装包 / 本地工具 =====
tools/

