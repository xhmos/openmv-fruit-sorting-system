# Nginx 反代示例（Windows / Linux 通用语法）
#
# 部署布局：
#   前端静态资源  -> frontend/dist（npm run build 产物）
#   后端服务      -> waitress 监听 127.0.0.1:5000
#   对外          -> Nginx 80/443
#
# 三个必须配对的点：
#   1. client_max_body_size 与后端 MAX_CONTENT_LENGTH（3MB）保持一致，否则大图会被 Nginx 先拦
#   2. /socket.io/ 必须带 Upgrade / Connection 头，否则实时推送退化成轮询
#   3. /api/device/stream 是 MJPEG 长连接，必须关闭 proxy_buffering，否则画面不刷新

upstream fruit_backend {
    server 127.0.0.1:5000;
}

server {
    listen 80;
    server_name your-domain.com;      # 换成实际域名或服务器 IP

    server_tokens off;
    client_max_body_size 3m;

    # 安全响应头（页面 + 接口都生效；CSP 的 style 留 unsafe-inline 是 Element Plus 需要）
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(self)" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws: wss:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;

    # ---------- 敏感路径探测：转给后端返回 404 并记录 ----------
    # try_files 兜底会把 /.env、/wp-login.php 这类请求返回 200 index.html，
    # 扫描器会误判为「文件存在」。转给后端既拿到真 404，也让后端的
    # 特征库把来源 IP / 路径 / 次数写进安全中心。
    location ~* "(/\.(env|git|svn|hg|htaccess|aws|ds_store)|wp-login|wp-admin|phpmyadmin|xmlrpc\.php|/etc/passwd|phpinfo|actuator|config\.json)" {
        proxy_pass http://fruit_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # ---------- 前端静态页面 ----------
    location / {
        root   C:/Users/10149/Desktop/openMV/frontend/dist;
        index  index.html;
        # 前端是 hash 路由，这条兜底主要用于兜住 index.html
        try_files $uri $uri/ /index.html;
    }

    # ---------- REST 接口 ----------
    location /api/ {
        proxy_pass http://fruit_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # 覆盖而不是追加：客户端自带的 X-Forwarded-For 不可信，
        # 追加会让攻击者伪造 IP 绕过登录限流、污染安全审计的来源
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # ---------- MJPEG 实时流（长连接，不缓冲） ----------
    location /api/device/stream {
        proxy_pass http://fruit_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;           # 关键：不缓冲，画面才能连续出
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # ---------- 上传的分拣图片 ----------
    location /uploads/ {
        proxy_pass http://fruit_backend;
        proxy_set_header Host $host;
        expires 60s;
    }

    # ---------- Socket.IO（必须支持协议升级） ----------
    location /socket.io/ {
        proxy_pass http://fruit_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       $host;
        proxy_read_timeout 3600s;
    }
}
